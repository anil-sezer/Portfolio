---
extends: default

rules:
  line-length:
    max: 160
    level: warning

  comments:
    require-starting-space: true
    ignore-shebangs: true
    min-spaces-from-content: 1

  comments-indentation: disable

# Ignore helm values files
ignore: |
  *helm-values.yml
  *helm-deployment-values.yml
  *helm-deamonset-values.yml

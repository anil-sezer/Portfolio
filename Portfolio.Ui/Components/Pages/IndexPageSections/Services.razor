@page "/Services"
@using Portfolio.Ui.Models

<section id="services" class="services section-bg">
    <div class="container">

        <div class="section-title">
            <h2>Tech Stack</h2>
            <p>This is the tech I used to deploy this system. Highlights what I'm proficient at. <br/>
                You can check the source code at <a href="https://github.com/anil-sezer/Portfolio" style="font-weight: bold;">my GitHub!</a> </p>
        </div>

        @code {
            private IReadOnlyList<TechStackModel> _modelToRender = TechStackModel.GetTechStack();
            const string BoxDivClass = "col-lg-4 col-md-6 icon-box";
            byte _delayForAppearance = 0;
            const byte DefaultIncrementToDelay = 0;
        }
        <div class="row">
            @foreach (var model in _modelToRender)
            {
                <div class="@BoxDivClass" data-aos="fade-up" data-aos-delay="@(_delayForAppearance += DefaultIncrementToDelay)">
                    <div class="icon">
                        <a href="@model.WebsiteLink" target="_blank">
                            <img src="@model.ImageAddress" width="@model.ImageWidth" height="@model.ImageHeight" alt="@model.ImageAltText">
                        </a>
                    </div>
                    <h4 class="title"><a href="@model.WebsiteLink">@model.Name</a></h4>
                    <p class="description">
                        @((MarkupString)model.Description)
                    </p>
                </div>
            }
        </div>
    </div>
</section>
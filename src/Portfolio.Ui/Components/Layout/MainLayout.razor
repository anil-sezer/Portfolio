@using System.Globalization
@inherits LayoutComponentBase

<button type="button" 
        class="mobile-nav-toggle d-xl-none" 
        aria-label="Toggle navigation" 
        aria-expanded="false" 
        aria-controls="header">
    <BsIcon Name="list" Class="mobile-nav-icon-list" />
    <BsIcon Name="x" Class="mobile-nav-icon-close" />
</button>

<header id="header">
    <div class="d-flex flex-column">

        <div class="profile">
            <picture class="d-block">
                <source type="image/avif" srcset="@Assets["img/pp_pic-240.avif"] 1x, @Assets["img/pp_pic-400.avif"] 2x" />
                <source type="image/webp" srcset="@Assets["img/pp_pic-240.webp"] 1x, @Assets["img/pp_pic-400.webp"] 2x" />
                <img src="@Assets["img/pp_pic-240.jpg"]"
                     srcset="@Assets["img/pp_pic-240.jpg"] 1x, @Assets["img/pp_pic-400.jpg"] 2x"
                     width="240"
                     height="240"
                     class="img-fluid rounded-circle"
                     alt="My profile pic. Lush forest background with me, turned to camera and slightly smiling."
                     loading="lazy"
                     decoding="async" />
            </picture>
            <h1 class="text-light"><a href="/">Anıl Sezer</a></h1>
            
            @{
                var currentCulture = CultureInfo.CurrentUICulture.Name;
                var isTr = currentCulture.StartsWith("tr", StringComparison.OrdinalIgnoreCase);
                var isEn = currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase);
            }

            <div class="d-flex justify-content-center align-items-center gap-2 mt-2 mb-1">
                <div class="language-switcher btn-group btn-group-sm rounded-pill p-1 bg-dark bg-opacity-50 border border-secondary" role="group" aria-label="Language switcher">
                    <a href="/tr" 
                       class="btn rounded-pill px-2 py-0 border-0 @(isTr ? "btn-light shadow-sm" : "")" 
                       title="Türkçe" 
                       lang="tr"
                       aria-current="@(isTr ? "true" : "false")">
                        <span class="lang-tr">TR</span>
                    </a>
                    <a href="/" 
                       class="btn rounded-pill px-2 py-0 border-0 @(isEn ? "btn-light shadow-sm" : "")" 
                       title="English" 
                       lang="en"
                       aria-current="@(isEn ? "true" : "false")">
                        <span class="lang-en">EN</span>
                    </a>
                </div>

                <button type="button" 
                        class="btn rounded-circle theme-toggle-btn bg-dark bg-opacity-50 border border-secondary text-light p-0" 
                        title="Toggle theme" 
                        aria-label="Toggle theme"
                        onclick="if (window.themeManager) { window.themeManager.toggleTheme(); }">
                    <BsIcon Name="moon-stars-fill" Class="theme-icon-dark" />
                    <BsIcon Name="sun-fill" Class="theme-icon-light" />
                </button>
            </div>


            <div class="social-links mt-2 text-center">
                <a href="https://github.com/anil-sezer" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><BsIcon Name="github" /></a>
                <a href="https://www.linkedin.com/in/anil-sezer/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><BsIcon Name="linkedin" /></a>
            </div>
        </div>

        <nav id="navbar" class="nav-menu navbar">
            <ul>
                <li><a href="#hero"         class="nav-link active"><BsIcon Name="camera2" /> <span>@L["Nav_Home"]</span></a></li>
                <li><a href="#clusterInfo"  class="nav-link"><BsIcon Name="diagram-3-fill" /> <span>@L["Nav_ClusterInfo"]</span></a></li>
                <li><a href="#techstack"    class="nav-link"><BsIcon Name="tools" /> <span>@L["Nav_TechStack"]</span></a></li>
                <li><a href="#resume"       class="nav-link"><BsIcon Name="file-text-fill" /> <span>@L["Nav_Resume"]</span></a></li>
                <li><a href="#about"        class="nav-link"><BsIcon Name="person-check-fill" /> <span>@L["Nav_About"]</span></a></li>
                <li><a href="#contact"      class="nav-link"><BsIcon Name="telephone-fill" /> <span>@L["Nav_Contact"]</span></a></li>
            </ul>
        </nav>
    </div>
</header>

@Body

<footer id="footer">
    <div class="container">
        <div class="credits">
            <b>@L["Footer_Bing"] <br/>
                <a href="https://www.microsoft.com/en-us/bing/bing-wallpaper" target="_blank" rel="noopener noreferrer">Bing Daily Wallpapers</a></b> <br/>
            <b>Tech stack section Gradient from: 
                <a href="https://x.com/POSTWOOK/status/2097037189049925818" target="_blank" rel="noopener noreferrer">Post Wook</a></b>
        </div>
    </div>
</footer>

<a href="#" class="back-to-top d-flex align-items-center justify-content-center" aria-label="Back to top"><BsIcon Name="arrow-up-short" /></a>

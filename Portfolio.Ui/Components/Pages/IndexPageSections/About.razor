
<section id="about" class="about">
    <div class="container">
        <div class="section-title">
            <h2>@L["About_Title"]</h2>
        </div>
        <div class="row">
            <div class="col-lg-4">
                <picture class="d-block">
                    <source type="image/avif" srcset="img/pp_pic-400.avif 400w, img/pp_pic-800.avif 800w" sizes="(max-width: 991px) 100vw, 400px" />
                    <source type="image/webp" srcset="img/pp_pic-400.webp 400w, img/pp_pic-800.webp 800w" sizes="(max-width: 991px) 100vw, 400px" />
                    <img id="about-me-pic"
                         src="img/pp_pic-400.jpg"
                         srcset="img/pp_pic-400.jpg 400w, img/pp_pic-800.jpg 800w"
                         sizes="(max-width: 991px) 100vw, 400px"
                         width="400"
                         height="400"
                         class="img-fluid"
                         alt="My profile pic. Lush forest background with me, turned to camera and slightly smiling."
                         loading="lazy"
                         decoding="async" />
                </picture>
            </div>
            <div class="col-lg-8 pt-4 pt-lg-0 content">
                <h3>@L["About_Subtitle"]</h3>
                <div class="row">
                    <div class="col-lg-6">
                        <ul>
                            <li><BsIcon Name="chevron-right" /> <strong>@L["About_Age"]</strong> <span>@(DateTime.Now.Year - 1993)</span></li>
                            <li><BsIcon Name="chevron-right" /> <strong>@L["About_Mail"]</strong> <span>msnanil@hotmail.com</span></li>

                        </ul>
                    </div>
                    <div class="col-lg-6">
                        <ul>
                            <li><BsIcon Name="chevron-right" /> <strong>@L["About_City"]</strong> <span>@L["About_CityValue"]</span></li>
                            <li><BsIcon Name="chevron-right" /> <strong>@L["About_Phone"]</strong> <span>+90 531 627 53 29</span></li>
                        </ul>
                    </div>
                </div>
                
                <p>
                    @L["About_Paragraph1"]<br/><br/>
                    
                    @((MarkupString)L["About_Paragraph2"].Value)<br/><br/>

                    @L["About_Paragraph3"]
                </p>
            </div>
        </div>

    </div>
</section>
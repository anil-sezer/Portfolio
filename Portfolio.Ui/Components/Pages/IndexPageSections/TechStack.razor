@using Portfolio.Ui.Models
@using Portfolio.Ui.Resources
@inject IStringLocalizer<AppResources> L

<section id="techstack" class="section-bg">
    <div class="container">

        <div class="section-title">
            <h2>@L["TechStack_Title"]</h2>
            <p>@((MarkupString)L["TechStack_Subtitle"].Value)</p>
        </div>
        
    <div class="tech-stack-grid">
        @foreach (var model in TechStackModel.GetTechStack())
        {
            <div class="tech-stack-card icon-box">

                <div class="temp-container1">
                    <div class="icon">
                        <a href="@model.WebsiteLink" target="_blank">
                            <img src="@model.ImageAddress" width="@model.ImageWidth" height="@model.ImageHeight" alt="@model.ImageAltText">
                        </a>
                    </div>
                </div>

                <div class="temp-container2">
                    <h4 class="title"><a href="@model.WebsiteLink">@model.Name</a></h4>
                    <p class="description">
                        @((MarkupString)model.Description)
                    </p>
                </div>
            </div>
        }
    </div>
    </div>
</section>
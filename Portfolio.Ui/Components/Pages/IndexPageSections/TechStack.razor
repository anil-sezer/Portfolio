@using System.Globalization
@using Portfolio.Ui.Models

<section id="techstack">
    <!-- Film Grain Texture Overlay -->
    <svg class="noise-overlay" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <filter id="techstack-film-grain">
            <feTurbulence type="fractalNoise" baseFrequency="0.75" numOctaves="3" stitchTiles="stitch" />
            <feColorMatrix type="saturate" values="0" />
        </filter>
        <rect width="100%" height="100%" filter="url(#techstack-film-grain)" />
    </svg>

    <!-- Starfield on Right Side -->
    <div class="stars-layer" aria-hidden="true">
        @foreach (var star in Stars)
        {
            <span class="star" style="left: @star.Left; top: @star.Top; width: @star.Size; height: @star.Size; opacity: @star.Opacity;"></span>
        }
    </div>

    <!-- Crescent Moon -->
    <div class="moon" aria-hidden="true" title="Crescent Moon"></div>

    <div class="container">

        <div class="section-title">
            <h2>@L["TechStack_Title"]</h2>
            <p>@((MarkupString)L["TechStack_Subtitle"].Value)</p>
        </div>
        
    <div class="tech-stack-grid">
        @foreach (var model in TechStackModel.GetTechStack())
        {
            <div class="tech-stack-card icon-box">

                <div class="temp-container1">
                    <div class="icon">
                        <a href="@model.WebsiteLink" target="_blank">
                            <img src="@model.ImageAddress" width="@model.ImageWidth" height="@model.ImageHeight" alt="@L[model.ImageAltTextKey]">
                        </a>
                    </div>
                </div>

                <div class="temp-container2">
                    <h4 class="title"><a href="@model.WebsiteLink">@model.Name</a></h4>
                    <p class="description">
                        @((MarkupString)L[model.DescriptionKey].Value)
                    </p>
                </div>
            </div>
        }
    </div>
    </div>
</section>

@code {
    private record Star(string Left, string Top, string Size, string Opacity);

    private static readonly Star[] Stars = GenerateStars();

    private static Star[] GenerateStars()
    {
        var rand = new Random(42);
        var list = new Star[160];
        for (var i = 0; i < 160; i++)
        {
            var x = 45.0 + rand.NextDouble() * 54.0;
            var y = 0.5 + rand.NextDouble() * 98.5;
            var size = rand.NextDouble() < 0.25 
                ? (1.8 + rand.NextDouble() * 1.2) 
                : (0.9 + rand.NextDouble() * 0.7);
            var opacity = 0.35 + rand.NextDouble() * 0.55;

            var leftStr = x.ToString("0.0", CultureInfo.InvariantCulture) + "%";
            var topStr = y.ToString("0.0", CultureInfo.InvariantCulture) + "%";
            var sizeStr = size.ToString("0.0", CultureInfo.InvariantCulture) + "px";
            var opacityStr = opacity.ToString("0.00", CultureInfo.InvariantCulture);

            list[i] = new Star(leftStr, topStr, sizeStr, opacityStr);
        }
        return list;
    }
}
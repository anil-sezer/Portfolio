@inherits LayoutComponentBase

<i class="bi bi-list mobile-nav-toggle d-xl-none"></i>
<script>
     (function () {
         const select = (el, all = false) => {
             el = el.trim()
             if (all) {
                 return [...document.querySelectorAll(el)]
             } else {
                 return document.querySelector(el)
             }
         }

         const on = (type, el, listener, all = false) => {
             let selectEl = select(el, all)
             if (selectEl) {
                 if (all) {
                     selectEl.forEach(e => e.addEventListener(type, listener))
                 } else {
                     selectEl.addEventListener(type, listener)
                 }
             }
         }

         on('click', '.mobile-nav-toggle', function(e) {
             select('body').classList.toggle('mobile-nav-active')
             this.classList.toggle('bi-list')
             this.classList.toggle('bi-x')
         })
     })();
 </script>

<header id="header">
    <div class="d-flex flex-column">

        <div class="profile">
            <img src="img/pp_pic.jpeg" class="img-fluid rounded-circle" alt="My profile pic. Lush forest background with me, turned to camera and slightly smiling."/>
            <h1 class="text-light"><a asp-page="@nameof(Index)">Anıl Sezer</a></h1>
            <div class="social-links mt-3 text-center">
                <a href="https://github.com/anil-sezer" target="_blank"><i class="bi bi-github"></i></a>
                <a href="https://www.linkedin.com/in/anil-sezer/" target="_blank"><i class="bi bi-linkedin"></i></a>
            </div>
        </div>

        <nav id="navbar" class="nav-menu navbar">
            <ul>
                <li><a href="#hero"     class="@GetActiveClass("hero")"><i class="bi bi-house-fill"></i> <span>Home</span></a></li>
                <li><a href="#services" class="@GetActiveClass("services")"><i class="bi bi-layers-fill"></i> <span>Tech Stack</span></a></li>
                <li><a href="#about"    class="@GetActiveClass("about")"><i class="bi bi-person-check-fill"></i> <span>About</span></a></li>
                <li><a href="#resume"   class="@GetActiveClass("resume")"><i class="bi bi-file-text-fill"></i> <span>Resume</span></a></li>
                <li><a href="#contact"  class="@GetActiveClass("contact")"><i class="bi bi-envelope-plus-fill"></i> <span>Contact</span></a></li>
            </ul>
        </nav>
        
        <script>
            function initializeObserver(dotnetHelper) {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const sectionId = entry.target.id;
                            console.log(`✅ Section ${sectionId} is intersecting: ${entry.isIntersecting}`);
                            dotnetHelper.invokeMethodAsync("SetActiveSection", sectionId);
                        }
                    });
                }, {
                    threshold: 0.5 // 50% of the section is visible
                });

                document.querySelectorAll("section").forEach((section) => {
                    observer.observe(section);
                });
            }
            
            @inject IJSRuntime JsRuntime
    
            @code {
                private DotNetObjectReference<MainLayout> _dotNetHelper = null!;
                private string ActiveSection { get; set; } = "hero";
    
    
                protected override async Task OnAfterRenderAsync(bool firstRender)
                {
                    if (firstRender)
                    {
                        _dotNetHelper = DotNetObjectReference.Create(this);
                        await JsRuntime.InvokeVoidAsync("initializeObserver", _dotNetHelper);
                    }
                }
    
                [JSInvokable]
                public void SetActiveSection(string sectionId)
                {
                    Console.WriteLine($"Active section: {sectionId}");
                    ActiveSection = sectionId;
                    InvokeAsync(StateHasChanged);
                }
    
                public void Dispose()
                {
                    _dotNetHelper?.Dispose();
                }
    
            }
    
            @code {
    
                private string GetActiveClass(string sectionId) =>
                    ActiveSection == sectionId ? "nav-link active" : "nav-link";
    
            }
        
        </script>
    </div>
</header>

@Body

<footer id="footer">
    <div class="container">
        <div class="credits">
            <b>Background image is by <br/>
                <a href="https://www.microsoft.com/en-us/bing/bing-wallpaper" target="_blank">Bing Daily Wallpapers</a></b><br/>
            Favicon by <a href="https://icons8.com" target="_blank">Icons8</a>
        </div>
    </div>
</footer>

<a href="#" class="back-to-top d-flex align-items-center justify-content-center">
    <i class="bi bi-arrow-up-short"></i>
</a>
<script>
    (function () {
        const backtotop = document.querySelector('.back-to-top');

        if (backtotop) {
            const toggleBacktotop = () => {
                if (window.scrollY > 100) {
                    backtotop.classList.add('active');
                } else {
                    backtotop.classList.remove('active');
                }
            };

            window.addEventListener('load', toggleBacktotop);
            window.addEventListener('scroll', toggleBacktotop);
        }
    })();
</script>

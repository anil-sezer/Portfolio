
<section id="about" class="about">
    <div class="container">
        <div class="section-title">
            <h2>@L["About_Title"]</h2>
        </div>
        <div class="row">
            <div class="col-lg-4">
                <img id="about-me-pic" src="img/pp_pic.jpeg" class="img-fluid" alt="My profile pic. Lush forest background with me, turned to camera and slightly smiling."/>
            </div>
            <div class="col-lg-8 pt-4 pt-lg-0 content">
                <h3>@L["About_Subtitle"]</h3>
                <div class="row">
                    <div class="col-lg-6">
                        <ul>
                            <li><i class="bi bi-chevron-right"></i> <strong>@L["About_Age"]</strong> <span>@(DateTime.Now.Year - 1993)</span></li>
                            <li><i class="bi bi-chevron-right"></i> <strong>@L["About_Mail"]</strong> <span>msnanil@hotmail.com</span></li>

                        </ul>
                    </div>
                    <div class="col-lg-6">
                        <ul>
                            <li><i class="bi bi-chevron-right"></i> <strong>@L["About_City"]</strong> <span>@L["About_CityValue"]</span></li>
                            <li><i class="bi bi-chevron-right"></i> <strong>@L["About_Phone"]</strong> <span>+90 531 627 53 29</span></li>
                        </ul>
                    </div>
                </div>
                
                <p>
                    @L["About_Paragraph1"]<br/><br/>
                    
                    @((MarkupString)L["About_Paragraph2"].Value)<br/><br/>

                    @L["About_Paragraph3"]
                </p>
            </div>
        </div>

    </div>
</section>
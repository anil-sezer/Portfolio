@using Portfolio.Ui.Models
@using Portfolio.Ui.Services
@inject BackgroundImageService BackgroundImageService;

@if (_backgroundImg != null)
{
    var mobileImageUrl = _backgroundImg.IsFallback ? Assets[_backgroundImg.MobileImageUrl] : _backgroundImg.MobileImageUrl;
    var desktopImageUrl = _backgroundImg.IsFallback ? Assets[_backgroundImg.DesktopImageUrl] : _backgroundImg.DesktopImageUrl;

    <HeadContent>
        <link rel="preload"
              as="image"
              type="image/webp"
              href="@mobileImageUrl"
              media="(max-width: 768px)"
              fetchpriority="high" />
        <link rel="preload"
              as="image"
              type="image/webp"
              href="@desktopImageUrl"
              media="(min-width: 769px)"
              fetchpriority="high" />
    </HeadContent>

    <section id="hero" class="d-flex flex-column justify-content-center align-items-center">
        <picture>
            <source media="(max-width: 768px)" srcset="@mobileImageUrl" type="image/webp" />
            <img class="hero-bg"
                 src="@desktopImageUrl"
                 alt="@_backgroundImg.AltText"
                 width="1920"
                 height="1080"
                 fetchpriority="high" />
        </picture>
        <div class="hero-container">
            <h1><span>@L["Hero_Title"]</span></h1>
            <p><span>@((MarkupString)L["Hero_Greeting"].Value)</span></p>
        </div>
        <div class="bing-credit">
            <b>@L["Hero_BingCredit"] <br/><a href="https://www.microsoft.com/en-us/bing/bing-wallpaper" target="_blank" rel="noopener noreferrer">Bing Daily Wallpapers</a></b>
        </div>
        <a href="#main"
           id="heroScrollIndicator"
           class="hero-scroll-indicator"
           aria-label="@L["Hero_ScrollDown"]">
            <div class="chevrons-stack" aria-hidden="true">
                <svg class="chevron-svg" viewBox="0 0 24 14" fill="none" stroke="currentColor">
                    <path d="M2 2L12 12L22 2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <svg class="chevron-svg" viewBox="0 0 24 14" fill="none" stroke="currentColor">
                    <path d="M2 2L12 12L22 2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
        </a>
    </section>
}
else
{
    <div>Loading...</div>
}


@code {
    private BackgroundImageModel? _backgroundImg;
    
    protected override async Task OnInitializedAsync()
    {
        _backgroundImg = await BackgroundImageService.GetFromCacheAsync();
    }
}

@using Portfolio.Ui.Endpoints
@using Portfolio.Ui.Services
@inject ClusterStatsService ClusterStatsService

<!-- Stats Section -->
<section id="clusterInfo" class="stats section" data-stats-url="@ClusterStatsEndpoints.Route">
    <div class="container">

        <div class="section-title">
            <h2>@L["Cluster_Title"]</h2>
            <p>
                @((MarkupString)L["Cluster_Subtitle"].Value)
            </p>
        </div>

        <div class="stats-live-container">
            <span class="live-indicator" title="@L["Cluster_LiveTooltip"]" aria-label="@L["Cluster_LiveText"]">
                <span class="live-dot" aria-hidden="true"></span>
                <span class="live-text">@L["Cluster_LiveText"]</span>
            </span>
        </div>

        <div id="stats-list">

            <div class="stats-item">
                <div class="stats-icon-container">
                    <img src="@Assets["img/cluster/pod-128.png"]" width="80" height="80" alt="Kubernetes Pod" class="stats-icon" loading="lazy" decoding="async"/>
                </div>
                <div class="stats-text-container">
                    <span class="counter"><span id="pods-count">@_targetPodCount</span> @L["Cluster_Pods"]</span>
                    <p>@L["Cluster_PodsDesc"]</p>
                </div>
            </div>

            <div class="stats-item">
                <div class="stats-icon-container">
                    <img src="@Assets["img/cluster/svc-128.png"]" width="80" height="80" alt="Kubernetes Service" class="stats-icon" loading="lazy" decoding="async"/>
                </div>
                <div class="stats-text-container">
                    <span class="counter"><span id="services-count">@_targetServiceCount</span> @L["Cluster_Services"]</span>
                    <p>
                        @((MarkupString)L["Cluster_ServicesDesc"].Value)
                    </p>
                </div>
            </div>

            <div class="stats-item">
                <div class="stats-icon-container">
                    <img src="@Assets["img/cluster/deploy-128.png"]" width="80" height="80" alt="Kubernetes Deployment" class="stats-icon" loading="lazy" decoding="async"/>
                </div>
                <div class="stats-text-container">
                    <span class="counter"><span id="deployments-count">@_targetDeploymentCount</span> @L["Cluster_Deployments"]</span>
                    <p>@((MarkupString)L["Cluster_DeploymentsDesc"].Value)</p>
                </div>
            </div>

            <div class="stats-item">
                <div class="stats-icon-container">
                    <img src="@Assets["img/cluster/cronjob-128.png"]" width="80" height="80" alt="Kubernetes Cron Job" class="stats-icon" loading="lazy" decoding="async"/>
                </div>
                <div class="stats-text-container">
                    <span class="counter"><span id="cronjobs-count">@_targetCronJobCount</span> @L["Cluster_CronJobs"]</span>
                    <p>@L["Cluster_CronJobsDesc"]</p>
                </div>
            </div>

            <div class="stats-item">
                <div class="stats-icon-container">
                    <img src="@Assets["img/cluster/node-128.png"]" width="80" height="80" alt="Kubernetes Node" class="stats-icon" loading="lazy" decoding="async"/>
                </div>
                <div class="stats-text-container">
                    <span class="counter"><span id="nodes-count">@_targetNodeCount</span> @L["Cluster_Nodes"]</span>
                    <p>@L["Cluster_NodesDesc"]</p>
                </div>
            </div>

        </div>

    </div>

</section>

@code {
    private int _targetPodCount;
    private int _targetServiceCount;
    private int _targetDeploymentCount;
    private int _targetCronJobCount;
    private int _targetNodeCount;

    protected override void OnInitialized()
    {
        var stats = ClusterStatsService.GetCachedStats();
        if (stats is not null)
        {
            _targetPodCount = stats.ActivePodCount;
            _targetServiceCount = stats.ServiceCount;
            _targetDeploymentCount = stats.DeploymentCount;
            _targetCronJobCount = stats.CronJobCount;
            _targetNodeCount = stats.NodeCount;
        }
    }
}
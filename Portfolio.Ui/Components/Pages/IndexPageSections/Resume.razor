@using Portfolio.Ui.Resources
@inject IStringLocalizer<AppResources> L

<section id="resume" class="resume section-bg">
    <div class="container">

        <div class="section-title">
            <h2>@L["Resume_Title"]</h2>
            <p>
                @((MarkupString)L["Resume_Subtitle"].Value)
            </p>
        </div>
        
        <!-- First Column -->
        <div class="row">
            <div class="col-lg-6">
                <h3 class="resume-title">@L["Resume_ProfExp"]</h3>
                
                <div class="resume-item">
                    <h4>@L["Resume_Job1_Title"]</h4>
                    <h5>@L["Resume_Job1_Date"]</h5>
                    <p><em>@L["Resume_Job1_Company"]</em></p>
                    <ul>
                        <li>@L["Resume_Job1_Bullet1"]</li>
                    </ul>
                </div>
                
                <div class="resume-item">
                    <h4>@L["Resume_Job2_Title"]</h4>
                    <h5>@L["Resume_Job2_Date"]</h5>
                    <p><em>@L["Resume_Job2_Company"]</em></p>
                    <ul>
                        <li>@L["Resume_Job2_Bullet1"]</li>
                        <li>@L["Resume_Job2_Bullet2"]</li>
                        <li>@L["Resume_Job2_Bullet3"]</li>
                        <li>@L["Resume_Job2_Bullet4"]</li>
                    </ul>
                </div>
                
                <div class="resume-item">
                    <h4>@L["Resume_Job3_Title"]</h4>
                    <h5>@L["Resume_Job3_Date"]</h5>
                    <p><em>@L["Resume_Job3_Company"]</em></p>
                    <ul>
                        <li>@L["Resume_Job3_Bullet1"]</li>
                        <li>@L["Resume_Job3_Bullet2"]</li>
                        <li>@L["Resume_Job3_Bullet3"]</li>
                        <li>@L["Resume_Job3_Bullet4"]</li>
                    </ul>
                </div>
                
                <div class="resume-item">
                    <h4>@L["Resume_Job4_Title"]</h4>
                    <h5>@L["Resume_Job4_Date"]</h5>
                    <p><em>@L["Resume_Job4_Company"]</em></p>
                    <ul>
                        <li>@L["Resume_Job4_Bullet1"]</li>
                    </ul>
                </div>
                
                <div class="resume-item">
                    <h4>@L["Resume_Job5_Title"]</h4>
                    <h5>@L["Resume_Job5_Date"]</h5>
                    <p><em>@L["Resume_Job5_Company"]</em></p>
                    <ul>
                        <li>@L["Resume_Job5_Bullet1"]</li>
                    </ul>
                </div>
                
                <div class="resume-item">
                    <h4>@L["Resume_Job6_Title"]</h4>
                    <h5>@L["Resume_Job6_Date"]</h5>
                    <p><em>@L["Resume_Job6_Company"]</em></p>
                    <ul>
                        <li>@((MarkupString)L["Resume_Job6_Bullet1"].Value)</li>
                    </ul>
                </div>
            </div>
            
            <!-- Second Column -->
            <div class="col-lg-6">

                <h3 class="resume-title">@L["Resume_Education"]</h3>
                
                <div class="resume-item">
                    <h4>@L["Resume_Edu1_Title"]</h4>
                    <p><em>@L["Resume_Edu1_School"]</em></p>
                    <h5>2021</h5>
                </div>
                
                <div class="resume-item">
                    <h4>@L["Resume_Edu2_Title"]</h4>
                    <p><em>@L["Resume_Edu2_School"]</em></p>
                    <h5>2021</h5>
                </div>
                
                <div class="resume-item">
                    <h4>@L["Resume_Edu3_Title"]</h4>
                    <p><em>@L["Resume_Edu3_School"]</em></p>
                    <h5>2020</h5>
                </div>

                <div class="resume-item">
                    <h4>@L["Resume_Edu4_Title"]</h4>
                    <h5>2013 - 2018</h5>
                    <p><em>@L["Resume_Edu4_Degree"]</em></p>
                </div>

                <div class="resume-item">
                    <h4>@((MarkupString)L["Resume_Edu5_Title"].Value)</h4>
                    <h5>2017</h5>
                    <p><em>@L["Resume_Edu5_Degree"]</em></p>
                </div>

                <div class="resume-item">
                    <h4>@L["Resume_Edu6_Title"]</h4>
                    <h5>2007 - 2011</h5>
                    <p><em>@L["Resume_Edu6_Degree"]</em></p>
                </div>
                
            </div>
        </div>

    </div>
</section>
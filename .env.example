# ==============================================================================
# Portfolio Environment Variables Template
# Copy this file to .env and replace placeholder values with your real configuration.
# Referenced by: Portfolio.Infrastructure/Extensions/EnvVars.cs
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Runtime
# ------------------------------------------------------------------------------
# Options: Development | Production | Staging
ASPNETCORE_ENVIRONMENT=Development

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Host: use 'localhost' for local dotnet run, or 'db_postgres' when using Docker Compose
SQL_DB_HOST=localhost
SQL_DB_PORT=5432
SQL_DB_USER=postgres
SQL_DB_PASSWORD=your_secure_password_here
SQL_DB_NAME=portfolio

# ------------------------------------------------------------------------------
# gRPC Backend Endpoint
# ------------------------------------------------------------------------------
# URL used by Portfolio.Ui to communicate with Portfolio.Grpc.
# For local host development: http://localhost:8081
# For Docker Compose: http://grpc:8081
GRPC_BASE_URL=http://localhost:8081

# ------------------------------------------------------------------------------
# Observability & OpenTelemetry
# ------------------------------------------------------------------------------
# OpenTelemetry Collector HTTP/gRPC endpoint (Required in Production/Staging)
OTEL_COLLECTOR_ENDPOINT=http://localhost:4317

# ------------------------------------------------------------------------------
# Notifications (Telegram Bot)
# ------------------------------------------------------------------------------
# Telegram Bot API Token from @BotFather
NOTIFICATION_TELEGRAM_API_KEY=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# Telegram Chat ID (channel or group chat ID for alerts)
NOTIFICATION_TELEGRAM_CHAT_ID=-1001234567890

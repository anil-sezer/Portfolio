@inherits LayoutComponentBase

<!-- ======= Mobile nav toggle button ======= -->
<i class="bi bi-list mobile-nav-toggle d-xl-none"></i>

<!-- ======= Header ======= -->
<header id="header">
    <div class="d-flex flex-column">

        <div class="profile">
            <img src="img/pp_pic.jpeg" class="img-fluid rounded-circle" alt="My profile pic. Lush forest background with me, turned to camera and slightly smiling."/>
            <h1 class="text-light"><a asp-page="@nameof(Index)">Anıl Sezer</a></h1>
            <div class="social-links mt-3 text-center">
                <a href="https://github.com/anil-sezer" target="_blank"><i class="bi bi-github"></i></a>
                <a href="https://www.linkedin.com/in/anil-sezer/" target="_blank"><i class="bi bi-linkedin"></i></a>
            </div>
        </div>

        <nav id="navbar" class="nav-menu navbar">
            <ul>
                <li><a href="/#hero" class="nav-link scrollto active"><i class="bi bi-house-fill"></i> <span>Home</span></a></li>
                <li><a href="/#services" class="nav-link scrollto"><i class="bi bi-layers-fill"></i> <span>Tech Stack</span></a></li>
                <li><a href="/#about" class="nav-link scrollto"><i class="bi bi-person-check-fill"></i> <span>About</span></a></li>
                <li><a href="/#resume" class="nav-link scrollto"><i class="bi bi-file-text-fill"></i> <span>Resume</span></a></li>
                <li><a href="/#contact" class="nav-link scrollto"><i class="bi bi-envelope-plus-fill"></i> <span>Contact</span></a></li>
            </ul>
        </nav><!-- .nav-menu -->
    </div>
</header><!-- End Header -->

@Body

<footer id="footer">
    <div class="container">
        <div class="credits">
            <b>Background image is by <a href="https://www.microsoft.com/en-us/bing/bing-wallpaper" target="_blank">Bing Daily Wallpapers</a></b><br/> Favicon by <a href="https://icons8.com" target="_blank">Icons8</a>
        </div>
    </div>
</footer>

<a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>





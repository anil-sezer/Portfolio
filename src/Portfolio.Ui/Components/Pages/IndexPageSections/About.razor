
<section id="about" class="about">
    <div class="container">
        <div class="section-title">
            <h2>@L["About_Title"]</h2>
        </div>
        <div class="row">
            <div class="col-lg-4">
                <picture class="d-block">
                    <source type="image/avif" srcset="@Assets["img/cat_pp-400.avif"] 400w, @Assets["img/cat_pp-800.avif"] 800w" sizes="(max-width: 991px) 100vw, 400px" />
                    <source type="image/webp" srcset="@Assets["img/cat_pp-400.webp"] 400w, @Assets["img/cat_pp-800.webp"] 800w" sizes="(max-width: 991px) 100vw, 400px" />
                    <img id="about-me-pic"
                         src="@Assets["img/cat_pp-400.jpg"]"
                         srcset="@Assets["img/cat_pp-400.jpg"] 400w, @Assets["img/cat_pp-800.jpg"] 800w"
                         sizes="(max-width: 991px) 100vw, 400px"
                         width="400"
                         height="400"
                         class="img-fluid"
                         alt="Anıl Sezer with kittens brawling on his shoulder and one at the back, sleeping"
                         loading="lazy"
                         decoding="async" />
                </picture>
            </div>
            <div class="col-lg-8 pt-4 pt-lg-0 content">
                <h3>@L["My_Title"]</h3>
                <div class="row">
                    <div class="col-lg-6">
                        <ul>
                            <li><BsIcon Name="chevron-right" /> <strong>@L["About_Experience"]</strong> <span>@L["About_ExperienceValue"]</span></li>
                            <li><BsIcon Name="chevron-right" /> <strong>@L["About_Mail"]</strong> <span>msnanil@hotmail.com</span></li>

                        </ul>
                    </div>
                    <div class="col-lg-6">
                        <ul>
                            <li><BsIcon Name="chevron-right" /> <strong>@L["About_City"]</strong> <span>@L["About_CityValue"]</span></li>
                            <li><BsIcon Name="chevron-right" /> <strong>@L["About_Phone"]</strong> <span>+90 531 627 53 29</span></li>
                        </ul>
                    </div>
                </div>
                
                <p>
                    @L["About_Paragraph1"]<br/><br/>
                    
                    @((MarkupString)L["About_Paragraph2"].Value)<br/><br/>

                    @L["About_Paragraph3"]
                </p>
            </div>
        </div>

    </div>
</section>
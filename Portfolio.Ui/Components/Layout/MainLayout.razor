@using System.Globalization
@using Portfolio.Ui.Resources
@inherits LayoutComponentBase
@inject IStringLocalizer<AppResources> L
@inject NavigationManager Navigation

<i class="bi bi-list mobile-nav-toggle d-xl-none"></i>
<script src="js/mobilenavtoggle.js"></script>

<header id="header">
    <div class="d-flex flex-column">

        <div class="profile">
            <img src="img/pp_pic.jpeg" class="img-fluid rounded-circle" alt="My profile pic. Lush forest background with me, turned to camera and slightly smiling."/>
            <h1 class="text-light"><a asp-page="@nameof(Index)">Anıl Sezer</a></h1>
            
            @{
                var currentCulture = CultureInfo.CurrentUICulture.Name;
                var relativeUrl = Uri.EscapeDataString("/" + Navigation.ToBaseRelativePath(Navigation.Uri));
                var isTr = currentCulture.StartsWith("tr", StringComparison.OrdinalIgnoreCase);
                var isEn = currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase);
            }

            <div class="d-flex justify-content-center align-items-center gap-2 mt-2 mb-1">
                <div class="language-switcher btn-group btn-group-sm rounded-pill p-1 bg-dark bg-opacity-50 border border-secondary" role="group" aria-label="Language switcher">
                    <a href="/SetCulture?culture=tr-TR&redirectUri=@relativeUrl" 
                       class="btn rounded-pill px-3 py-0 border-0 @(isTr ? "btn-light shadow-sm" : "")" 
                       title="Türkçe" 
                       lang="tr"
                       aria-current="@(isTr ? "true" : "false")">
                        <span class="lang-tr">TR</span>
                    </a>
                    <a href="/SetCulture?culture=en-US&redirectUri=@relativeUrl" 
                       class="btn rounded-pill px-3 py-0 border-0 @(isEn ? "btn-light shadow-sm" : "")" 
                       title="English" 
                       lang="en"
                       aria-current="@(isEn ? "true" : "false")">
                        <span class="lang-en">EN</span>
                    </a>
                </div>

                <button type="button" 
                        class="btn rounded-circle theme-toggle-btn bg-dark bg-opacity-50 border border-secondary text-light p-0" 
                        title="Toggle theme" 
                        aria-label="Toggle theme"
                        onclick="if (window.themeManager) { window.themeManager.toggleTheme(); }">
                    <i class="bi bi-moon-stars-fill theme-icon-dark"></i>
                    <i class="bi bi-sun-fill theme-icon-light"></i>
                </button>
            </div>


            <div class="social-links mt-2 text-center">
                <a href="https://github.com/anil-sezer" target="_blank"><i class="bi bi-github"></i></a>
                <a href="https://www.linkedin.com/in/anil-sezer/" target="_blank"><i class="bi bi-linkedin"></i></a>
            </div>
        </div>

        <nav id="navbar" class="nav-menu navbar">
            <ul>
                <li><a href="#hero"         class="@GetActiveClass("hero")"><i class="bi bi-house-fill"></i> <span>@L["Nav_Home"]</span></a></li>
                <li><a href="#clusterInfo"  class="@GetActiveClass("clusterInfo")"><i class="bi bi-layers-fill"></i> <span>@L["Nav_ClusterInfo"]</span></a></li>
                <li><a href="#techstack"    class="@GetActiveClass("techstack")"><i class="bi bi-layers-fill"></i> <span>@L["Nav_TechStack"]</span></a></li>
                <li><a href="#about"        class="@GetActiveClass("about")"><i class="bi bi-person-check-fill"></i> <span>@L["Nav_About"]</span></a></li>
                <li><a href="#resume"       class="@GetActiveClass("resume")"><i class="bi bi-file-text-fill"></i> <span>@L["Nav_Resume"]</span></a></li>
                <li><a href="#contact"      class="@GetActiveClass("contact")"><i class="bi bi-envelope-plus-fill"></i> <span>@L["Nav_Contact"]</span></a></li>
            </ul>
        </nav>
        <script>
            function initializeObserver(dotnetHelper) {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const sectionId = entry.target.id;
                            dotnetHelper.invokeMethodAsync("SetActiveSection", sectionId);
                        }
                    });
                }, {
                    threshold: 0.5 // 50% of the section is visible
                });

                document.querySelectorAll("section").forEach((section) => {
                    observer.observe(section);
                });
            }
            
            @inject IJSRuntime JsRuntime
    
            @code {
                private DotNetObjectReference<MainLayout> _dotNetHelper = null!;
                private string ActiveSection { get; set; } = "hero";
    
    
                protected override async Task OnAfterRenderAsync(bool firstRender)
                {
                    if (firstRender)
                    {
                        _dotNetHelper = DotNetObjectReference.Create(this);
                        await JsRuntime.InvokeVoidAsync("initializeObserver", _dotNetHelper);
                    }
                }
    
                [JSInvokable]
                public void SetActiveSection(string sectionId)
                {
                    ActiveSection = sectionId;
                    InvokeAsync(StateHasChanged);
                }
    
                private string GetActiveClass(string sectionId) => ActiveSection == sectionId ? "nav-link active" : "nav-link";
    
                public void Dispose()
                {
                    _dotNetHelper.Dispose();
                }
            }
        </script>
    </div>
</header>

@Body

<footer id="footer">
    <div class="container">
        <div class="credits">
            <b>@L["Footer_Bing"] <br/>
                <a href="https://www.microsoft.com/en-us/bing/bing-wallpaper" target="_blank">Bing Daily Wallpapers</a></b><br/>
            @L["Footer_Favicon"] <a href="https://icons8.com" target="_blank">Icons8</a>
        </div>
    </div>
</footer>

<a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

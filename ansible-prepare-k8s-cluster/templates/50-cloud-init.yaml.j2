network:
  version: 2
  ethernets:
    eth0:
      dhcp4: false
      addresses:
        - {{ ansible_host }}/24
      routes:
        - to: default
          via: {{ cluster_lan_gateway }}
      nameservers:
        addresses:
{% for dns in cluster_dns_servers %}
          - {{ dns }}
{% endfor %}
      ignore-carrier: true
      critical: true
